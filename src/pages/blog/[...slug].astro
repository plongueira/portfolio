---
import { url } from '../../lib/url';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  <article>
    <header class="page-head">
      <time class="eyebrow" datetime={post.data.date.toISOString()}>
        {formatDate(post.data.date)}
      </time>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
    <p class="back"><a class="text-link" href={url('/blog/')}>← Volver al blog</a></p>
  </article>
</Base>
